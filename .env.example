# Скопируйте в .env, если запускаете проект без Docker.
DJANGO_SECRET_KEY=local-dev-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=buildshop
POSTGRES_USER=buildshop
POSTGRES_PASSWORD=buildshop_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Ключ API Checko (https://checko.ru, бесплатно 100 запросов в сутки) для проверки контрагентов.
CHECKO_API_KEY=
